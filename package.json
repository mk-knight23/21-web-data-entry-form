{
  "name": "21-web-enterprise-input",
  "private": false,
  "version": "2.1.0",
  "description": "Enterprise precision data entry portal modernized with React 19, Vite 6, and Tailwind CSS v4.",
  "type": "module",
  "scripts": {
    "production": "npm run build && npm start",
    "lint": "eslint .",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "type-check": "tsc --noEmit",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "typecheck": "tsc && vite build"
  },
  "keywords": [
    "data-entry",
    "portal",
    "react",
    "tailwind",
    "typescript",
    "enterprise"
  ],
  "author": "Kazi Musharraf",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mk-knight23/21-web-enterprise-input.git"
  },
  "homepage": "https://mk-knight23.github.io/21-web-enterprise-input/",
  "dependencies": {
    "clsx": "^2.1.1",
    "framer-motion": "^12.29.2",
    "lucide-react": "^0.474.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-router": "^7.13.0",
    "tailwind-merge": "^2.6.0",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@tailwindcss/vite": "^4.1.18",
    "@types/react": "^19.2.9",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.23",
    "eslint": "^9.39.2",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^17.1.0",
    "jsdom": "^24",
    "postcss": "^8.5.6",
    "prettier": "^3",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.53.1",
    "vite": "^6.4.1",
    "vitest": "^4.0.18"
  }
}
